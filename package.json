{
  "name": "tslua2",
  "private": true,
  "description": "tslua2 MMORPG project workspace",
  "scripts": {
    "build:tables": "npm run build --workspace=tables",
    "build:proto": "npm run build --workspace=protocols",
    "build:server": "dotnet build servercsharp/GameServer.sln -v q --nologo",
    "build:all": "npm run build:tables && npm run build:proto && npm run build:server",
    "test": "dotnet test servercsharp/src/GameServer.Tests --nologo -v q",
    "verify": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1 verify",
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1 dev"
  },
  "workspaces": [
    "protocols",
    "tables"
  ],
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.41"
  }
}
