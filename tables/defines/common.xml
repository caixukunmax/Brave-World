<module name="common">
<bean name="DateTimeRange" sep=";">
        <var name="start_time" type="datetime?"/>
        <var name="end_time" type="datetime?"/>
    </bean>

    <bean name="TimeOfDay" sep=":">
		<var name="hour" type="int"/>
		<var name="minute" type="int"/>
		<var name="second" type="int"/>
	</bean>

	<bean name="OneDayTimeRange" sep=";">
		<var name="start_time" type="TimeOfDay"/>
		<var name="end_time" type="TimeOfDay"/>
	</bean>

	<enum name="EBoolOperator">
		<var name="AND"/>
		<var name="OR"/>
	</enum>

	<enum name="EAttr" comment="统一属性枚举（玩家/怪物通用）">
		<var name="HP" alias="生命值" value="1"/>
		<var name="MAX_HP" alias="最大生命" value="2"/>
		<var name="MP" alias="魔法值" value="3"/>
		<var name="MAX_MP" alias="最大魔法" value="4"/>
		<var name="PATK" alias="物攻" value="6"/>
		<var name="MATK" alias="魔攻" value="7"/>
		<var name="PDEF" alias="物防" value="8"/>
		<var name="MDEF" alias="魔防" value="9"/>
		<var name="MOVE_SPEED" alias="移动速度" value="10"/>
		<var name="MP_REGEN" alias="MP恢复" value="11"/>
	</enum>

	<bean name="IntRange">
		<var name="min" type="int"/>
		<var name="max" type="int"/>
	</bean>

	<bean name="FloatRange">
		<var name="min" type="float"/>
		<var name="max" type="float"/>
	</bean>

	<bean name="GlobalConfig">
		<!-- 背包相关 -->
	    <var name="x1" type="int" comment="背包容量"/>
	    <var name="x2" type="int"/>
	    <var name="x3" type="int"/>
	    <var name="x4" type="int"/>
	    <var name="x5" type="int"/>
	    <var name="x6" type="int"/>
	    <var name="x7" type="(list#sep=|),int"/>
	</bean>

	<table name="TbGlobalConfig" value="GlobalConfig" mode="one" input="common/全局常量配置表.xlsx"/>

	<!-- 地形配置 -->
	<bean name="TerrainConfig">
		<var name="id" type="int" comment="地形类型ID"/>
		<var name="name" type="string" comment="显示名称"/>
		<var name="description" type="string" comment="描述"/>
		<var name="walkable" type="bool" comment="是否可行走"/>
		<var name="move_speed_ratio" type="float" comment="移动速度倍率"/>
		<var name="can_swim" type="bool" comment="是否可游泳"/>
		<var name="patk_modifier" type="float" comment="物理攻击修正"/>
		<var name="matk_modifier" type="float" comment="魔法攻击修正"/>
		<var name="pdef_modifier" type="float" comment="物理防御修正"/>
		<var name="mdef_modifier" type="float" comment="魔法防御修正"/>
		<var name="hp_regen_per_sec" type="int" comment="每秒HP恢复"/>
		<var name="mp_regen_per_sec" type="int" comment="每秒MP恢复"/>
		<var name="fire_damage_bonus" type="int" comment="火系伤害加成"/>
		<var name="ice_damage_bonus" type="int" comment="冰系伤害加成"/>
		<var name="poison_damage_bonus" type="int" comment="毒系伤害加成"/>
		<var name="color_r" type="int" comment="叠加色R(0-255)"/>
		<var name="color_g" type="int" comment="叠加色G"/>
		<var name="color_b" type="int" comment="叠加色B"/>
		<var name="color_a" type="float" comment="叠加透明度(0-1)"/>
		<var name="particle_effect" type="string" comment="粒子效果路径"/>
	</bean>

	<table name="TbTerrainConfig" value="TerrainConfig" mode="map" input="common/TbTerrainConfig.xlsx"/>

</module>
